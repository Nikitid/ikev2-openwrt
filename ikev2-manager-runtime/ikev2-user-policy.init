#!/bin/sh /etc/rc.common

# Install the fail-closed inbound guard before strongSwan loads client
# connections. The table is valid with empty session sets and is populated by
# the dedicated VICI event watcher as clients connect.
START=88
# Keep the guard until XFRM has gone down (K89) during shutdown.
STOP=90
USE_PROCD=1

start_service() {
	[ -x /usr/libexec/ikev2-user-policy ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/ikev2-user-policy watch
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	[ -x /usr/libexec/ikev2-user-policy ] || return 0
	/usr/libexec/ikev2-user-policy stop
}

reload_service() {
	# HUP is procd's default reload signal. Passing it as the second argument
	# would be interpreted as an instance name by older OpenWrt procd helpers.
	procd_send_signal ikev2-user-policy
}
