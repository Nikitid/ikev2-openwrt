#!/bin/sh /etc/rc.common

START=96
# Stop the coordinator before domain-router (K3), DNS segments (K4), XFRM
# (K89) and network (K90). Otherwise its current cycle can recreate a service
# that shutdown has already stopped.
STOP=02
USE_PROCD=1

start_service() {
	[ "$(uci -q get ikev2-manager.globals.configured)" = 1 ] ||
	[ "$(uci -q get ikev2-manager.client.enabled)" = 1 ] ||
	[ "$(uci -q get ikev2-manager.server.enabled)" = 1 ] ||
		return 0
	procd_open_instance
	procd_set_param command /usr/libexec/ikev2-health
	procd_set_param respawn 3600 5 5
	# The TERM trap only snapshots small nft sets, but keep shutdown bounded if
	# nft or another child process is ever stuck while procd stops the watcher.
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
